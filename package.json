{
  "name": "code-mcp-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Bun native gateway for exposing local code-mcp servers",
  "scripts": {
    "start": "bun run gateway/server.ts",
    "dev": "bun --watch gateway/server.ts",
    "build": "bun build --target=bun gateway/build.ts --outdir=dist --bundle && chmod +x dist/build.js",
    "install-service": "bun run gateway/build.ts install",
    "uninstall-service": "bun run gateway/build.ts uninstall"
  }
}
