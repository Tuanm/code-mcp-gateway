{
  "name": "code-mcp-gateway-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker gateway for exposing local code-mcp servers via WebSocket tunneling",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test": "bun test test/*.test.ts && bun test/run-smoke.ts && bun test/files.ts",
    "test:files": "bun test/files.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.141.0"
  },
  "allowScripts": {
    "workerd@1.20250718.0": true,
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  }
}
